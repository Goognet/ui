#!/usr/bin/env php
<?php

declare(strict_types = 1);

/*
 * Renders the component catalogue to build/docs/index.html for GitHub Pages.
 *
 * Run `npm run build:docs` first: the page links the assets that build writes, through the same
 * `@vite` a site uses, so what gets published is what a site renders.
 */

use AndreiIonita\BladeRemixIcon\BladeRemixIconServiceProvider;
use BladeUI\Heroicons\BladeHeroiconsServiceProvider;
use BladeUI\Icons\BladeIconsServiceProvider;
use Goognet\Ui\UiServiceProvider;
use Goognet\Ui\Support\Catalogue;
use Illuminate\Support\Facades\Vite;
use Orchestra\Testbench\Foundation\Application;

require __DIR__ . '/../vendor/autoload.php';

$root = dirname(__DIR__);
$output = $root . '/build/docs';

if (! is_file($output . '/build/manifest.json')) {
    fwrite(STDERR, "Missing build/docs/build/manifest.json — run `npm run build:docs` first.\n");

    exit(1);
}

$app = Application::create(options: ['extra' => ['providers' => [
    BladeIconsServiceProvider::class,
    BladeHeroiconsServiceProvider::class,
    BladeRemixIconServiceProvider::class,
    UiServiceProvider::class,
]]]);

$app->usePublicPath($output);

$app['config']->set([
    'app.name'                     => 'goognet/ui',
    /* The catalogue is written in Portuguese, so the components it renders speak it too. */
    'app.locale'                   => 'pt_BR',
    'app.url'                      => getenv('DOCS_URL') ?: 'https://goognet.github.io/ui',
    'app.key'                      => 'base64:' . base64_encode(random_bytes(32)),
    'goognet-ui.catalogue.enabled' => true,
    'goognet-ui.catalogue.public'  => true,
    'goognet-ui.catalogue.version' => getenv('DOCS_VERSION') ?: trim((string) shell_exec('git -C ' . escapeshellarg($root) . ' describe --tags --abbrev=0 2>/dev/null')),
    'goognet-ui.catalogue.vite'    => ['docs/app.css', 'docs/app.js'],
]);

/*
 * Relative, so the pages work under /ui/ on github.io and on a custom domain alike. The prefix
 * follows the page being written: the index sits at the root and a component one folder in.
 */
$prefix = '';

/** By reference: an arrow function captures by value, and the prefix changes after this line. */
Vite::createAssetPathsUsing(function (string $path) use (&$prefix): string {
    return $prefix . $path;
});

/* A folder per component — /ui/button/ — rather than /ui/button.html, which the URLs then carry. */
$link = function (?string $name) use (&$prefix): string {
    return $name === null ? ($prefix === '' ? './' : $prefix) : $prefix . $name . '/';
};

$write = function (string $path, string $html) use ($output): int {
    $target = $output . ($path === '' ? '' : '/' . $path) . '/index.html';

    if (! is_dir(dirname($target))) {
        mkdir(dirname($target), recursive: true);
    }

    file_put_contents($target, $html);

    return strlen($html);
};

$bytes = $write('', view('goognet-ui::components.catalogue.index', ['link' => $link])->render());

$pages = 1;

$prefix = '../';

foreach (Catalogue::entries() as $entry) {
    $bytes += $write($entry['name'], view('goognet-ui::components.catalogue.component', [
        'doc'  => $entry,
        'link' => $link,
    ])->render());

    $pages++;
}

/* GitHub Pages runs Jekyll by default, which drops files and folders starting with an underscore. */
touch($output . '/.nojekyll');

fwrite(STDOUT, sprintf("build/docs — %d páginas, %d kB no total\n", $pages, intdiv($bytes, 1024)));
